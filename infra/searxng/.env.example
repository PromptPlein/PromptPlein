# Kopieer naar .env en vul in. .env wordt niet gecommit.

# De DNS-naam van deze server, bijvoorbeeld zoeken.promptplein.nl
DOMAIN=

# Het slot op de server. Maak er een lange willekeurige waarde van:
#   openssl rand -hex 32
# Dezelfde waarde gaat in de Supabase-secrets als SEARXNG_TOKEN.
SEARCH_TOKEN=

# Interne sleutel van SearXNG (sessies, CSRF). Ook:  openssl rand -hex 32
SEARXNG_SECRET=
