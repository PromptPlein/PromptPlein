# Supabase configuratie.
# Laat leeg om de app te draaien met een lokale (localStorage) mock-database.
# Vul in om verbinding te maken met een echte Supabase-instantie.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optioneel: directe URL naar de "optimize-prompt" Supabase Edge Function.
# Standaard wordt <VITE_SUPABASE_URL>/functions/v1/optimize-prompt gebruikt.
VITE_OPTIMIZE_FUNCTION_URL=
